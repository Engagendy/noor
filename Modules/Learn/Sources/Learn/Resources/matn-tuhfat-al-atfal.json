 "lines": [
  {
   "number": 1,
   "section_id": "s1",
   "first": "يَقُولُ رَاجِي رَحمةِ الْغَفُورِ",
   "second": "دَوْمَاً سُلَيْمَانُ هُوَ الْجَمْزُورِى",
   "start": null
  },
  {
   "number": 2,
   "section_id": "s1",
   "first": "الْحَمْدُ لِلَّهِ مُصَلِّياً عَلى",
   "second": "مُحَمَدٍ وآلِهِ وَمَنْ تَلاَ",
   "start": null
  },
  {
   "number": 3,
   "section_id": "s1",
   "first": "وَبَعْدُ هذَا النَّظْمُ لِلْمُرِيدِ",
   "second": "في النُونِ والتَّنْوِينِ وَالْمُدُودِ",
   "start": null
  },
  {
   "number": 4,
   "section_id": "s1",
   "first": "سَمَّيتُهُ بِتُحفَة الأَطْفَالِ",
   "second": "عَنْ شَيْخِنَا الْمِيهِىِّ ذِي الْكَمالِ",
   "start": null
  },
  {
   "number": 5,
   "section_id": "s1",
   "first": "أَرْجُو بِه أَنْ يَنْفَعَ الطُّلاَّبَا",
   "second": "وَالأَجْرَ وَالْقَبُولَ وَالثَّوَابا",
   "start": null
  },
  {
   "number": 6,
   "section_id": "s2",
   "first": "لِلنُّونِ إِنْ تَسْكُنْ وَلِلتَّنْوِينِ",
   "second": "أَرْبَعُ أَحْكَامٍ فَخُذْ تَبْيِينِي",
   "start": null
  },
  {
   "number": 7,
   "section_id": "s2",
   "first": "فَالأَوَّلُ الإظْهَارُ قَبْلَ أَحْرُفِ",
   "second": "لِلْحَلْقِ سِتٍ رُتِّبَتْ فَلتَعْرِفِ",
   "start": null
  },
  {
   "number": 8,
   "section_id": "s2",
   "first": "هَمْزٌ فَهَاءٌ ثُمَّ عَيْنٌ حَاءُ",
   "second": "مُهْمَلَتَانِ ثُمَّ غَيْنٌ خَاءُ",
   "start": null
  },
  {
   "number": 9,
   "section_id": "s2",
   "first": "والثَّاني إِدْغَامٌ بِستَّةٍ أَتَتْ",
   "second": "فِي يَرْمَلُونَ عِنْدَهُمْ قَدْ ثَبَتَتْ",
   "start": null
  },
  {
   "number": 10,
   "section_id": "s2",
   "first": "لَكِنَّهَا قِسْمَانِ قِسْمٌ يُدْغَمَا",
   "second": "فِيهِ بِغُنَّةٍ بِيَنْمُو عُلِمَا",
   "start": null
  },
  {
   "number": 11,
   "section_id": "s2",
   "first": "إِلاَّ إِذَا كَانَا بِكِلْمَةٍ فَلاَ",
   "second": "تُدْغِمْ كَدُنْيَا ثُمَّ صِنْوَانٍ تَلاَ",
   "start": null
  },
  {
   "number": 12,
   "section_id": "s2",
   "first": "وَالثَّاني إِدْغَامٌ بِغَيْرِ غُنَّةْ",
   "second": "في اللاَّمِ وَالرَّا ثُمَّ كَرّرَنَّهْ",
   "start": null
  },
  {
   "number": 13,
   "section_id": "s2",
   "first": "وَّالثَالثُ الإِقْلاَبُ عِنْدَ الْبَاءِ",
   "second": "مِيماً بِغُنَةٍ مَعَ الإِخْفَاءِ",
   "start": null
  },
  {
   "number": 14,
   "section_id": "s2",
   "first": "وَالرَّابِعُ الإِخْفَاءُ عِنْدَ الْفاضِلِ",
   "second": "مِنَ الحُرُوفِ وَاجِبٌ لِلْفَاضِلِ",
   "start": null
  },
  {
   "number": 15,
   "section_id": "s2",
   "first": "في خَمْسَةٍ مِنْ بَعْدِ عَشْرٍ رَمْزُهَا",
   "second": "فِي كِلْمِ هذَا البَيْتِ قَدْ ضَمَّنْتُهَا",
   "start": null
  },
  {
   "number": 16,
   "section_id": "s2",
   "first": "صِفْ ذَا ثَنَا كَمْ جَادَ شَخْصٌ قَدْ سمَا",
   "second": "دُمْ طَيَّباً زِدْ فِي تُقَىً ضَعْ ظَالِمَا",
   "start": null
  },
  {
   "number": 17,
   "section_id": "s3",
   "first": "وَغُنَّ مِيماً ثُمَّ نُوناً شُدِّدَا",
   "second": "وَسَمِّ كُلاً حَرْفَ غُنَّةٍ بَدَا",
   "start": null
  },
  {
   "number": 18,
   "section_id": "s4",
   "first": "وَالِميمُ إِنْ تَسْكُنْ تَجِى قَبْلَ الْهِجَا",
   "second": "لاَ أَلفٍ لَيِّنَةٍ لِذِى الْحِجَا",
   "start": null
  },
  {
   "number": 19,
   "section_id": "s4",
   "first": "أَحْكَامُهَا ثَلاَثَةٌ لِمَنْ ضَبَطْ",
   "second": "إِخْفَاءٌ ادْغَامٌ وَإِظْهَارٌ فَقَطْ",
   "start": null
  },
  {
   "number": 20,
   "section_id": "s4",
   "first": "فَالأَوَّلُ الإِخْفَاءُ عِنْدَ الْبَاءِ",
   "second": "وَسَمِّهِ الشَّفْوِىَّ لِلْقُرَّاءِ",
   "start": null
  },
  {
   "number": 21,
   "section_id": "s4",
   "first": "وَالثَّانى إِدْغَامٌ بِمِثْلِهَا أَتَى",
   "second": "وَسَمِّ إدغاماً صَغِيراً يَا فَتَى",
   "start": null
  },
  {
   "number": 22,
   "section_id": "s4",
   "first": "وَالثَّالِثُ الإِظْهَارُ فِى الْبَقِيَّةْ",
   "second": "مِنْ أَحْرُفٍ وَسَمِّهَا شَفْوِيَّهْ",
   "start": null
  },
  {
   "number": 23,
   "section_id": "s4",
   "first": "وَاحْذَرْ لَدَى وَاوٍ وَفَا أَنْ تَخْتَفىِ",
   "second": "لِقُرْبِهَا وَلاتحادِ فَاعْرِفِ",
   "start": null
  },
  {
   "number": 24,
   "section_id": "s5",
   "first": "لِلاَمِ أَلْ حَالاَنِ قَبْلَ الأَحْرُفِ",
   "second": "أُولاَهُمَا إِظْهَارُهَا فَلْتَعْرِفِ",
   "start": null
  },
  {
   "number": 25,
   "section_id": "s5",
   "first": "قَبْلَ ارْبَعٍ مَعْ عَشْرَةٍ خُذْ عِلْمَهُ",
   "second": "مِنَ ابْغِ حَجَّكَ وَخَفْ عَقِيمهُ",
   "start": null
  },
  {
   "number": 26,
   "section_id": "s5",
   "first": "ثَانِيهِمَا إِدْغَامُهَا فى أَرْبَعٍ",
   "second": "وَعَشْرَةٍ أَيْضاً وَرَمْزَهَا فَعِ",
   "start": null
  },
  {
   "number": 27,
   "section_id": "s5",
   "first": "طِبْ ثُمَّ صِلْ رُحْمَاً تَفُزْ ضِفْ ذَا نِعَم",
   "second": "دَعْ سُوءَ ظَنٍ زُرْ شَرِيفَاً لِلْكَرَم",
   "start": null
  },
  {
   "number": 28,
   "section_id": "s5",
   "first": "وَاللاَّمَ الاُولَى سَمِّهَا قَمْرِيَّهْ",
   "second": "وَاللاَّمَ الاُخْرىَ سَمِّهَا شَمْسِيَّهْ",
   "start": null
  },
  {
   "number": 29,
   "section_id": "s5",
   "first": "وأظْهِرَنَّ لاَمَ فِعْلٍ مُطْلَقاً",
   "second": "فى نَحْوِ قُلْ نَعَمْ وَقُلْنَا وَالْتَقَى",
   "start": null
  },
  {
   "number": 30,
   "section_id": "s6",
   "first": "إِنْ فِي الصِّفَاتِ وَالمَخَارِجِ اتَّفَقْ",
   "second": "حَرْفَانِ فَالْمِثْلاَنِ فِيهِمَا أَحَقْ",
   "start": null
  },
  {
   "number": 31,
   "section_id": "s6",
   "first": "وَإِنْ يَكُونَا مَخْرَجا ًتَقَارَبَا",
   "second": "وَفي الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا",
   "start": null
  },
  {
   "number": 32,
   "section_id": "s6",
   "first": "مُتْقَارِبَيْنِ أَوْ يَكُونَا اتَّفَقَا",
   "second": "فِي مَخْرَجٍ دُونَ الصِّفَاتِ حُقِّقَا",
   "start": null
  },
  {
   "number": 33,
   "section_id": "s6",
   "first": "بِالْمُتَجَانِسَيْنِ ثُمَّ إِنْ سَكَنْ",
   "second": "أَوَّلُ كُلٍّ فَالصَّغِيرَ سَمِّيَنْ",
   "start": null
  },
  {
   "number": 34,
   "section_id": "s6",
   "first": "أَوْ حُرِّكَ الحَرْفَانِ فى كُلٍّ فَقُلْ",
   "second": "كُلٌّ كَبِيرُ وافْهَمَنْهُ بِالْمُثُلْ",
   "start": null
  },
  {
   "number": 35,
   "section_id": "s7",
   "first": "وَالمَدُّ أَصْلِىُّ وَ فَرْعِىٌّ لَهُ",
   "second": "وَسَمِّ أَوَّلاً طَبِيعِيّاً وَهُو",
   "start": null
  },
  {
   "number": 36,
   "section_id": "s7",
   "first": "مَالاَ تَوَقُّفٌ لَهُ عَلى سَبَبْ",
   "second": "وَلابِدُونِهِ الحُرُوفُ تُجْتَلَبْ",
   "start": null
  },
  {
   "number": 37,
   "section_id": "s7",
   "first": "بلْ أَىُّ حَرْفٍ غَيْرُ هَمْزٍ أَوْ سُكُونْ",
   "second": "جَا بَعْدَ مَدٍّ فَالطَّبِيِعىَّ يَكُونْ",
   "start": null
  },
  {
   "number": 38,
   "section_id": "s7",
   "first": "وَالآخَرُ الْفَرْعِىُّ مَوْقُوفٌ عَلي",
   "second": "سَبَبْ كَهَمْزٍ أَوْ سُكُونٍ مُسْجَلاً",
   "start": null
  },
  {
   "number": 39,
   "section_id": "s7",
   "first": "حُرُوفُهُ ثَلاَثَةٌ فَعِيهَا",
   "second": "مِنْ لَفْظِ وَاىٍ وَهْىَ فى نُوحِيهَا",
   "start": null
  },
  {
   "number": 40,
   "section_id": "s7",
   "first": "وَالكَسْرُ قَبْلَ الْيَا وَقَبْلَ الْواوِ ضَمْ",
   "second": "شَرْطٌ وَفَتْحٌ قَبْلَ أَلفٍ يُلْتَزَمْ",
   "start": null
  },
  {
   "number": 41,
   "section_id": "s7",
   "first": "وَاللِّينُ مِنْهَا الْيَا وَوَاوٌ سَكَنَا",
   "second": "إِنِ انْفِتَاحٌ قَبْلَ كُلٍّ أُعْلِنَا",
   "start": null
  },
  {
   "number": 42,
   "section_id": "s8",
   "first": "لِلْمَدِّ أَحْكَامٌ ثَلاَثَةٌ تَدُومْ",
   "second": "وَهْيَ الْوُجُوبُ وَالْجَوَازُ وَاللُّزُومْ",
   "start": null
  },
  {
   "number": 43,
   "section_id": "s8",
   "first": "فَوَاجِبٌ إِنْ جَاءَ هَمْزٌ بَعْدَ مَدْ",
   "second": "فِي كِلْمَةٍ وَذَا بِمُتَّصْلٍ يُعَدْ",
   "start": null
  },
  {
   "number": 44,
   "section_id": "s8",
   "first": "وَجَائزٌ مَدٌ وَقَصْرٌ إِنْ فُصِل",
   "second": "كُلٌّ بِكِلْمَةٍ وَهَذَا المُنْفَصِلْ",
   "start": null
  },
  {
   "number": 45,
   "section_id": "s8",
   "first": "وَمِثْلُ ذَا إِنْ عَرَضَ السُّكُونُ",
   "second": "وَقْفَاً كَتَعْلَمُونَ نَسْتَعِينُ",
   "start": null
  },
  {
   "number": 46,
   "section_id": "s8",
   "first": "أَوْ قُدِّمَ الْهَمْزُ عَلَي المَدِّ وَذَا",
   "second": "بَدَلْ كَآمَنُوا وَإِيَماناً خُذَا",
   "start": null
  },
  {
   "number": 47,
   "section_id": "s8",
   "first": "وَلاَزِمٌ إِنِ السُّكُونُ أُصِّلاَ",
   "second": "وَصْلاَ وَوَقْفاً بَعْدَ مَدٍّ طُوّلاَ",
   "start": null
  },
  {
   "number": 48,
   "section_id": "s9",
   "first": "أَقْسَامُ لاَزِمٍ لَدَيهم أَرْبَعَةْ",
   "second": "وَتِلْكَ كِلْمِيُّ وَحَرْفِيٌّ مَعَهْ",
   "start": null
  },
  {
   "number": 49,
   "section_id": "s9",
   "first": "كِلاَهُمَا مُخَفَّفٌ مُثَقَّلُ",
   "second": "فَهَذِهِ أَرْبَعَةٌ تُفَصَّلُ",
   "start": null
  },
  {
   "number": 50,
   "section_id": "s9",
   "first": "فَإِنْ بِكِلْمَةٍ سُكُونٌ اجْتَمَعْ",
   "second": "مَعْ حَرْفِ مَدٍّ فَهْوَ كِلْمِيُّ وَقَعْ",
   "start": null
  },
  {
   "number": 51,
   "section_id": "s9",
   "first": "أَوْ في ثُلاَثِيِّ الحُرُوفِ وُجِدَا",
   "second": "وَالمَدُّ وَسْطُهُ فَحَرْفِيٌّ بَدَا",
   "start": null
  },
  {
   "number": 52,
   "section_id": "s9",
   "first": "كِلاَهُمَا مُثَقّلٌ إِنْ أُدْغِمَا",
   "second": "مَخَفَّفٌ كُلُّ إِذَا لَمْ يُدْغَمَا",
   "start": null
  },
  {
   "number": 53,
   "section_id": "s9",
   "first": "وَاللاَّزِمُ الْحَرفِيُّ أَوَّلَ السُّوَرْ",
   "second": "وُجُودُهُ وَفِي ثَمَانٍ انحَصَرْ",
   "start": null
  },
  {
   "number": 54,
   "section_id": "s9",
   "first": "يَجْمَعُهَا حُرُوفُ كَمْ عَسَلْ نَقَصْ",
   "second": "وَعَيْنُ ذُو وَجْهَيْنِ والطُّولُ أَخَصْ",
   "start": null
  },
  {
   "number": 55,
   "section_id": "s9",
   "first": "وَمَا سِوَي الحَرْفِ الثُّلاَثِي لاَ أَلِفْ",
