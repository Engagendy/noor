 ],
 "lines": [
  {
   "number": 1,
   "section_id": "s1",
   "first": "أَبْدَأُ بِالحَمْدِ مُصَلِّيَاً عَلَى",
   "second": "مُحَمَّدٍ خَيْرِ نَبِيٍّ أُرْسِلا",
   "start": null
  },
  {
   "number": 2,
   "section_id": "s1",
   "first": "وَذِي من أقْسَامِ الحَدِيثِ عِدَّهْ",
   "second": "وَكُلُّ وَاحِدٍ أَتَى وَحَدَّه",
   "start": null
  },
  {
   "number": 3,
   "section_id": "s2",
   "first": "أَوَّلُهَا الصَّحِيحُ وَهْوَ مَا اتَّصل",
   "second": "إسْنَادُهُ وَلَمْ يَشُذَّ أَوْ يُعَلْ",
   "start": null
  },
  {
   "number": 4,
   "section_id": "s2",
   "first": "يَرْوِيهِ عَدْلٌ ضَابِطٌ عَنْ مِثْلِه",
   "second": "مُعْتَمَدٌ فِي ضَبْطِهِ وَنَقْلِه",
   "start": null
  },
  {
   "number": 5,
   "section_id": "s2",
   "first": "وَالحَسَن المَعْرُوفُ طُرْقاً وَغَدَتْ",
   "second": "رِجَالُهُ لاَ كَالصَّحِيحِ اشْتَهَرَتْ",
   "start": null
  },
  {
   "number": 6,
   "section_id": "s2",
   "first": "وَكُلُّ مَا عَنْ رُتْبَةِ الحُسْنِ قَصرْ",
   "second": "فَهْوَ الضَّعِيفُ وَهْوَ أَقْسَاماً كَثُرُ",
   "start": null
  },
  {
   "number": 7,
   "section_id": "s2",
   "first": "وَمَا أُضِيفَ لَلنَّبِي المَرْفُوعُ",
   "second": "وَمَا لِتَابِعٍ هُوَالمَقْطُوعُ",
   "start": null
  },
  {
   "number": 8,
   "section_id": "s2",
   "first": "وَالمُسْنَدُ المتَّصِلُ الإسْنَاد",
   "second": "مِنْ رَاوِيهِ حَتَّى المُصْطَفَى وَلَمْ يَبِنْ",
   "start": null
  },
  {
   "number": 9,
   "section_id": "s2",
   "first": "وَمَا بِسَمْعِ كُلِّ رَاوٍ يَتَّصِل",
   "second": "إسْنَادُهُ لِلْمُصْطَفَى فَالْمُتَّصِل",
   "start": null
  },
  {
   "number": 10,
   "section_id": "s2",
   "first": "مُسَلْسَلٌ قُلْ مَا عَلَى وَصْفٍ أَتَى",
   "second": "مِثْلُ أَمَا وَاللهِ أَنْبَأنِي الْفَتَى",
   "start": null
  },
  {
   "number": 11,
   "section_id": "s2",
   "first": "كَذَاكَ قَدْ حَدَّثَنِيهِ قَائما",
   "second": "أَوْ بَعْدَ أَنْ حَدَّثَنِي تَبَسَّما",
   "start": null
  },
  {
   "number": 12,
   "section_id": "s2",
   "first": "عَزِيزُ مَرْوِي اثْنَيْنِ أوْ ثلاَثَهْ",
   "second": "مَشْهُورُ مَرْوِي فوْقَ مَا ثَلاَثَهْ",
   "start": null
  },
  {
   "number": 13,
   "section_id": "s2",
   "first": "مُعَنْعَنٌ كَعَنْ سَعِيدٍ عَنْ كَرَمْ",
   "second": "وَمُبْهَمٌ مَا فِيهِ رَاوٍ لَمْ يُسَمْ",
   "start": null
  },
  {
   "number": 14,
   "section_id": "s2",
   "first": "وَكُلُّ مَا قَلَّتْ رِجَالُهُ عَلاَ",
   "second": "وَضِدُهُ ذَاكَ الَّذِي قَدْ نَزَلاَ",
   "start": null
  },
  {
   "number": 15,
   "section_id": "s2",
   "first": "وَمَا أَضَفْتَهُ إِلَى الأَصْحَابِ مِنْ",
   "second": "قَوْلٍ وَفِعْلٍ فَهْو َمَوْقُوفٌ زُكِنْ",
   "start": null
  },
  {
   "number": 16,
   "section_id": "s2",
   "first": "وَمُرْسَلٌ مِنْهُ الصِّحَابِيُّ سَقَطْ",
   "second": "وَقُلْ غَرِيبٌ مَا رَوَى رَاوٍ فَقَطْ",
   "start": null
  },
  {
   "number": 17,
   "section_id": "s2",
   "first": "وَكُلُّ مَا لَمْ يَتَّصِلْ بِحَال",
   "second": "إسْنَادُهُ مُنْقَطِعُ الأَوْصَال",
   "start": null
  },
  {
   "number": 18,
   "section_id": "s2",
   "first": "والمُعْضل الساقِط مِنه اثنانِ",
   "second": "وما أتى مُدلساً نوعانِ",
   "start": null
  },
  {
   "number": 19,
   "section_id": "s2",
   "first": "الأَوَّلُ الاسْقَاطُ لِلشَّيْخِ وَأَنْ",
   "second": "يَنْقُلَ عَمَّنْ فَوْقَهُ بِعَنْ وَأَنْ",
   "start": null
  },
  {
   "number": 20,
   "section_id": "s2",
   "first": "وَالثَّانِ لاَ يُسقطُهُ لَكِنْ يَصِفْ",
   "second": "أَوْصَافَهُ بِمَا بِهِ لاَ يَنْعَرِفْ",
   "start": null
  },
  {
   "number": 21,
   "section_id": "s2",
   "first": "وَمَا يُخَالِفْ ثِقَةٌ بِهِ المَلاَ",
   "second": "فَالشَّاذ والمَقْلُوبُ قِسْمانِ تَلاَ",
   "start": null
  },
  {
   "number": 22,
   "section_id": "s2",
   "first": "إبْدَالُ رَاوٍ مَا بِرَاوٍ قِسْمُ",
   "second": "وَقَلْبُ إسْنَادٍ لمَتْنٍ قِسْمُ",
   "start": null
  },
  {
   "number": 23,
   "section_id": "s2",
   "first": "وَالْفَرْدُ مَا قَيَّدْتَهُ بِثِقةِ",
   "second": "أَوْ جَمْعٍ أو قَصْرٍ عَلَى رِوَايَةِ",
   "start": null
  },
  {
   "number": 24,
   "section_id": "s2",
   "first": "وَمَا بِعِلَّةٍ غُمُوضٍ أَوْ خَفَا",
   "second": "مُعَلَّلٌ عِنْدَهُمُ قَدْ عُرِفا",
   "start": null
  },
  {
   "number": 25,
   "section_id": "s2",
   "first": "وَذُو اخْتِلافِ سَنَدٍ أَوْ مَتْنِ",
   "second": "مُضْطَرِبٌ عِنْدَ أُهَيْلِ الْفَنِّ",
   "start": null
  },
  {
   "number": 26,
   "section_id": "s2",
   "first": "وَالمُدْرَجَاتُ فِي الحَدِيثِ مَا أَتَتْ",
   "second": "مِنْ بَعْض أَلْفَاظِ الرُّوَاةِ اتَّصَلَتْ",
   "start": null
  },
  {
   "number": 27,
   "section_id": "s2",
   "first": "وَمَا رَوَى كُلُّ قَرِينٍ عَنْ أَخِهْ",
   "second": "مُدّبَّجٌ فَأَعْرِفْهُ حَقّاً وَانْتَخِهْ",
   "start": null
  },
  {
   "number": 28,
   "section_id": "s2",
   "first": "مُتَّفِقٌ لَفْظاً وَخَطاً مُتَّفِقْ",
   "second": "وَضِدُّهُ فِيمَا ذَكَرْنَا المُفْتَرِقْ",
   "start": null
  },
  {
   "number": 29,
   "section_id": "s2",
   "first": "مُؤْتَلِفٌ مُتَّقِقُ الخَطِّ فَقَطْ",
   "second": "وَضِدُّهُ مُخْتَلِفُ فَاخْشَ الْغَلَطْ",
   "start": null
  },
  {
   "number": 30,
   "section_id": "s2",
   "first": "وَالمُنْكَرُ الْفَرْدُ بِهِ رَاوٍ غَدَا",
   "second": "تَعْدِيلُهُ لاَ يَحْمِلُ التَّفَرُّدَا",
   "start": null
  },
  {
   "number": 31,
   "section_id": "s2",
   "first": "مَتْرُوكُهُ مَا وَاحِدٌ بِهِ انْفَرَدْ",
   "second": "وَأَجْمَعُوا لِضَعْفِهِ فَهْوَ كَرَدْ",
   "start": null
  },
  {
   "number": 32,
   "section_id": "s2",
   "first": "وَالكَذِبُ المُخْتَلَقُ المَصْنُوعُ",
   "second": "عَلَى النَّبِي فَذلِكَ المَوْضُوعُ",
   "start": null
  },
  {
   "number": 33,
   "section_id": "s3",
   "first": "وَقَدْ أَتَتْ كَالجَوْهَرِ المَكْنُونِ",
   "second": "سَمَّيْتُهَا مَنْظُومَةَ الْبَيْقُونِي",
   "start": null
  },
  {
   "number": 34,
   "section_id": "s3",
   "first": "فَوْقَ الثَّلاَثِينَ بِأَرْبَعٍ أَتَتْ",
   "second": "أَقْسَامُهَا تَمَّتْ بِخَيْرٍ خُتِمَتْ",
   "start": null
  }
 ]
}
