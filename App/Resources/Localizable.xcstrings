    "Only the ayat with words worth glossing appear here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا الآيات التي فيها كلمات تحتاج بيانًا فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব আয়াতে ব্যাখ্যার মতো শব্দ আছে কেবল সেগুলোই এখানে দেখা যায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo aparecen las aleyas con palabras que necesitan explicación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنها آیه‌هایی که واژهٔ نیازمند توضیح دارند اینجا می‌آیند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les versets contenant des mots à expliquer apparaissent ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ayat yang memuat kata yang perlu dijelaskan yang muncul di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ayat yang mempunyai perkataan yang perlu dijelaskan muncul di sini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada yalnızca açıklanmaya değer kelimeler içeren ayetler görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں صرف وہ آیات آتی ہیں جن میں وضاحت طلب الفاظ ہیں۔"
          }
        }
      }
    },
    "Only the surahs you have downloaded were searched — the word may still be in the rest.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُبحث إلا في السور التي نزّلتها على جهازك — وقد تكون الكلمة في بقيّة السور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেবল আপনার ডাউনলোড করা সূরাগুলোতেই খোঁজা হয়েছে — শব্দটি বাকি সূরাগুলোতে থাকতে পারে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se buscó en las suras que has descargado: la palabra puede estar en las demás."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنها در سوره‌هایی که دانلود کرده‌اید جست‌وجو شد — ممکن است این واژه در بقیه باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche n’a porté que sur les sourates téléchargées — le mot peut se trouver dans les autres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang dicari hanya surah yang sudah Anda unduh — kata itu mungkin ada di surah lainnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya surah yang telah anda muat turun dicari — perkataan itu mungkin ada dalam surah yang selebihnya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca indirdiğiniz surelerde arama yapıldı — kelime diğerlerinde de geçiyor olabilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش صرف ان سورتوں میں ہوئی جو آپ نے ڈاؤن لوڈ کی ہیں — یہ لفظ باقی سورتوں میں بھی ہو سکتا ہے۔"
          }
        }
      }
    },
