    "Enter the gold price to compute the nisab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل سعر الذهب لحساب النصاب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিসাব হিসাব করতে সোনার দাম লিখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the gold price to compute the nisab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el precio del oro para calcular el nisab."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای محاسبهٔ نصاب، قیمت طلا را وارد کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le prix de l’or pour calculer le nisab."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan harga emas untuk menghitung nisab."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan harga emas untuk mengira nisab."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisabı hesaplamak için altın fiyatını girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نصاب معلوم کرنے کے لیے سونے کی قیمت درج کریں۔"
          }
        }
      }
    },
    "Enter today's local gold price — the nisab is the value of 85 grams of gold.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل سعر جرام الذهب اليوم — النصاب هو قيمة ٨٥ جرامًا من الذهب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের স্থানীয় সোনার দাম লিখুন — নিসাব হলো ৮৫ গ্রাম সোনার মূল্য।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter today's local gold price — the nisab is the value of 85 grams of gold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el precio local del oro de hoy: el nisab es el valor de 85 gramos de oro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قیمت امروز طلا در محل خود را وارد کنید — نصاب برابر ارزش ۸۵ گرم طلاست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le prix local de l’or du jour — le nisab vaut 85 grammes d’or."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan harga emas lokal hari ini — nisab adalah nilai 85 gram emas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan harga emas tempatan hari ini — nisab ialah nilai 85 gram emas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü yerel altın fiyatını girin — nisap 85 gram altının değeridir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی مقامی قیمتِ سونا درج کریں — نصاب ۸۵ گرام سونے کی قیمت ہے۔"
          }
        }
      }
    },
