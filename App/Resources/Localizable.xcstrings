    "Your choice is remembered, and is the same one the ayah sheet uses.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ اختيارك، وهو نفسه المستخدم في بطاقة تفسير الآية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পছন্দ মনে রাখা হয়, এবং আয়াতের শিটেও সেটিই ব্যবহার হয়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu elección se recuerda y es la misma que usa la ficha de la aleya."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب شما به خاطر سپرده می‌شود و همان است که برگهٔ آیه از آن استفاده می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre choix est mémorisé ; c’est celui qu’utilise la fiche du verset."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan Anda diingat, dan sama dengan yang dipakai lembar ayat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan anda disimpan, dan ia sama dengan yang digunakan pada kad ayat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçiminiz hatırlanır; ayet kartında da aynısı kullanılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا انتخاب یاد رکھا جاتا ہے، اور یہی آیت والی شیٹ میں بھی استعمال ہوتا ہے۔"
          }
        }
      }
    },
