    "Couldn't get your location": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحديد موقعك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লোকেশন পাওয়া গেল না"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener tu ubicación"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت شما به‌دست نیامد"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position introuvable"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
