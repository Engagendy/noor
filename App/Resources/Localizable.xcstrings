    "Downloaded once, readable forever offline. Public-domain dataset; see licenses in Settings.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزَّل مرة واحدة وتُقرأ دون إنترنت دائمًا. البيانات في الملك العام؛ انظر التراخيص في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার ডাউনলোড হলে চিরকাল অফলাইনে পড়া যায়। পাবলিক-ডোমেইন ডেটা; লাইসেন্স দেখুন সেটিংসে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded once, readable forever offline. Public-domain dataset; see licenses in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descarga una vez y se lee siempre sin conexión. Datos de dominio público; consulta las licencias en Ajustes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک‌بار دانلود می‌شود و همیشه آفلاین خواندنی است. داده‌ها در مالکیت عمومی‌اند؛ مجوزها را در تنظیمات ببینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargé une fois, lisible hors ligne pour toujours. Données du domaine public ; licences dans Réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diunduh sekali, bisa dibaca offline selamanya. Data domain publik; lihat lisensi di Setelan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimuat turun sekali, boleh dibaca luar talian selamanya. Set data domain awam; lihat lesen dalam Tetapan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez indirilir, çevrimdışı olarak hep okunur. Kamuya açık veri kümesi; lisanslar için Ayarlar'a bakın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار ڈاؤن لوڈ کریں، ہمیشہ آف لائن پڑھیں۔ عوامی ملکیت کا ڈیٹا؛ لائسنس ترتیبات میں دیکھیں۔"
          }
        }
      }
    },
