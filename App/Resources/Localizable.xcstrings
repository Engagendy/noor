    "No city found near your location. Search for the nearest city.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد مدينة قريبة من موقعك. ابحث عن أقرب مدينة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লোকেশনের কাছে কোনো শহর পাওয়া যায়নি। নিকটতম শহর খুঁজুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna ciudad cerca de tu ubicación. Busca la ciudad más cercana."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شهری نزدیک موقعیت شما پیدا نشد. نزدیک‌ترین شهر را جستجو کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune ville trouvée près de votre position. Recherchez la ville la plus proche."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada kota yang ditemukan dekat lokasi Anda. Cari kota terdekat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada bandar ditemui berhampiran lokasi anda. Cari bandar terdekat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuzun yakınında şehir bulunamadı. En yakın şehri arayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے مقام کے قریب کوئی شہر نہیں ملا۔ قریب ترین شہر تلاش کریں۔"
          }
        }
      }
    },
