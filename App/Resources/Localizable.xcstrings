    "Classical poems memorised by students of tajweed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منظومات كلاسيكية يحفظها طلاب التجويد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাজবিদের শিক্ষার্থীরা যে প্রাচীন কবিতাগুলো মুখস্থ করেন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poemas clásicos que memorizan los estudiantes de taywid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منظومه‌های کلاسیک که طلاب تجوید حفظ می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poèmes classiques que mémorisent les étudiants en Tajwid."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Syair klasik yang dihafal para pelajar tajwid."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Syair klasik yang dihafal oleh penuntut ilmu tajwid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecvid talebelerinin ezberlediği klasik manzumeler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلاسیکی منظومات جو تجوید کے طلبہ یاد کرتے ہیں۔"
          }
        }
      }
    },
    "Classical poems students memorise: tajweed, and the terms of hadith.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منظومات يحفظها طلبة العلم: في التجويد ومصطلح الحديث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিক্ষার্থীরা যে প্রাচীন কবিতাগুলো মুখস্থ করেন: তাজবিদ ও হাদিসের পরিভাষা।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poemas clásicos que memorizan los estudiantes: taywid y términos del hadiz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منظومه‌هایی که طلاب علم حفظ می‌کنند: تجوید و مصطلح حدیث."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poèmes que mémorisent les étudiants : Tajwid et terminologie du Hadith."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Syair klasik yang dihafal para pelajar: tajwid dan istilah hadis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Syair klasik yang dihafal penuntut ilmu: tajwid, dan istilah hadis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talebelerin ezberlediği klasik manzumeler: tecvid ve hadis usulü."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلاسیکی منظومات جو طلبہ یاد کرتے ہیں: تجوید اور اصطلاحاتِ حدیث میں۔"
          }
        }
      }
    },
