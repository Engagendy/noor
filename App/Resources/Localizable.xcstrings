    "Section headings are the app's, not the source's.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عناوين الأقسام من إضافة التطبيق لا من المصدر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অংশের শিরোনামগুলো অ্যাপের দেওয়া, মূল উৎসের নয়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos de sección son de la app, no de la fuente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان‌های بخش‌ها از خود برنامه است، نه از منبع."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intertitres viennent de l’app, non de la source."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul bagian berasal dari aplikasi, bukan dari sumbernya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk bahagian ialah tambahan apl, bukan daripada sumber."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölüm başlıkları kaynağa değil, uygulamaya aittir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
