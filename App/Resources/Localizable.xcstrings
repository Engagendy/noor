    "Showing %lld of %lld — open the text to see the rest": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض %1$lld من %2$lld — افتح النص لبقية النتائج"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld-এর মধ্যে %1$lld দেখানো হচ্ছে — বাকিটা দেখতে লেখাটি খুলুন"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando %1$lld de %2$lld: abre el texto para ver el resto"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش %1$lld از %2$lld — برای دیدن بقیه متن را باز کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld sur %2$lld affichés — ouvrez le texte pour la suite"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan %1$lld dari %2$lld — buka teksnya untuk melihat sisanya"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan %1$lld daripada %2$lld — buka teks untuk melihat selebihnya"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld sonuçtan %1$lld tanesi gösteriliyor — geri kalanı için metni açın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld میں سے %1$lld دکھائے جا رہے ہیں — باقی دیکھنے کے لیے متن کھولیں"
          }
        }
      }
    },
    "Showing the first %lld matches — refine your search.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض أول %lld نتيجة — حدِّد بحثك أكثر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথম %lld ফলাফল দেখানো হচ্ছে — সার্চ আরও নির্দিষ্ট করুন।"
          }
        },
        "es": {
