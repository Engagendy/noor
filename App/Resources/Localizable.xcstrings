          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نخستین %lld نتیجه نمایش داده می‌شود — جست‌وجو را دقیق‌تر کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld premiers résultats — affinez votre recherche."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan %lld hasil pertama — persempit pencarian Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan %lld padanan pertama — perhalusi carian anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk %lld sonuç gösteriliyor — aramanızı daraltın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے %lld نتائج دکھائے جا رہے ہیں — اپنی تلاش مزید محدود کریں۔"
