    "Tap a sound to hear it": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أي صوت لسماعه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
