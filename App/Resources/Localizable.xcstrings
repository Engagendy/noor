    "Match your local masjid exactly. Applies everywhere: timeline, widgets, and notifications.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طابق مسجدك المحلي تمامًا. يسري على كل شيء: المواقيت والودجات والتنبيهات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার এলাকার মসজিদের সঙ্গে হুবহু মিলিয়ে নিন। সব জায়গায় প্রযোজ্য: টাইমলাইন, উইজেট ও নোটিফিকেশন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match your local masjid exactly. Applies everywhere: timeline, widgets, and notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincide exactamente con tu mezquita local. Se aplica en todo: horarios, widgets y notificaciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دقیقاً با مسجد محلهٔ خود هماهنگ کنید. همه‌جا اعمال می‌شود: زمان‌بندی، ابزارک‌ها و اعلان‌ها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alignez-vous exactement sur votre mosquée. S’applique partout : horaires, widgets et notifications."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Samakan persis dengan masjid Anda. Berlaku di mana saja: jadwal, widget, dan notifikasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padankan tepat dengan masjid setempat anda. Terpakai di mana-mana: garis masa, widget dan pemberitahuan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahalle caminizle birebir aynı olsun. Her yerde geçerlidir: vakit listesi, widget'lar ve bildirimler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی مقامی مسجد سے بالکل مطابقت رکھیں۔ ہر جگہ لاگو ہوتا ہے: اوقات، وجیٹ اور اطلاعات۔"
          }
        }
      }
    },
