    },
    "Location Services are off. Turn them on in Settings, or pick a city manually.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمات الموقع مُعطَّلة. شغّلها من الإعدادات، أو اختر مدينة يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লোকেশন সার্ভিস বন্ধ আছে। সেটিংস থেকে চালু করুন, অথবা নিজে একটি শহর বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Servicios de ubicación están desactivados. Actívalos en Ajustes o elige una ciudad manualmente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمات موقعیت مکانی خاموش است. آن را در تنظیمات روشن کنید، یا شهری را دستی انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est désactivée. Activez-la dans Réglages, ou choisissez une ville manuellement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan Lokasi nonaktif. Aktifkan di Setelan, atau pilih kota secara manual."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan Lokasi dimatikan. Hidupkannya dalam Tetapan, atau pilih bandar secara manual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum Servisleri kapalı. Ayarlar'dan açın veya bir şehri elle seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام کی سروسز بند ہیں۔ انہیں ترتیبات میں آن کریں، یا خود کوئی شہر منتخب کریں۔"
          }
        }
      }
    },
    "Location access is restricted on this device. Pick a city manually.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع مقيّد على هذا الجهاز. اختر مدينة يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে লোকেশনের অনুমতি সীমিত। নিজে একটি শহর বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está restringido en este dispositivo. Elige una ciudad manualmente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به موقعیت مکانی در این دستگاه محدود شده است. شهری را دستی انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position est restreint sur cet appareil. Choisissez une ville manuellement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi dibatasi di perangkat ini. Pilih kota secara manual."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi disekat pada peranti ini. Pilih bandar secara manual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda konum erişimi kısıtlı. Bir şehri elle seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس پر مقام کی رسائی محدود ہے۔ خود کوئی شہر منتخب کریں۔"
          }
        }
      }
    },
