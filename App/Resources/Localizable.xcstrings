          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی هر صدا بزنید تا آن را بشنوید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un son pour l’écouter"
