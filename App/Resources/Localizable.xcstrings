    "Notifications are scheduled on your device for the next 12 days and roll forward automatically.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجدول الإشعارات على جهازك للأيام الاثني عشر القادمة وتتجدد تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগামী ১২ দিনের নোটিফিকেশন আপনার ডিভাইসেই নির্ধারিত থাকে এবং নিজে থেকেই সামনে এগিয়ে যায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones se programan en tu dispositivo para los próximos 12 días y se renuevan automáticamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌ها برای ۱۲ روز آینده روی دستگاه شما زمان‌بندی می‌شوند و خودبه‌خود به‌روز می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont programmées sur votre appareil pour les 12 prochains jours et se renouvellent automatiquement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi dijadwalkan di perangkat Anda untuk 12 hari ke depan dan diperbarui otomatis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dijadualkan pada peranti anda untuk 12 hari akan datang dan diperbaharui secara automatik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler cihazınızda önümüzdeki 12 gün için planlanır ve otomatik olarak yenilenir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات آپ کے آلے پر اگلے ۱۲ دن کے لیے طے کی جاتی ہیں اور خودبخود آگے بڑھتی رہتی ہیں۔"
          }
        }
      }
    },
    "Notifications are scheduled on your device for the next 12 days and roll forward automatically. Toggle individual prayers with the bell on the Prayer screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجدول الإشعارات على جهازك للأيام الاثني عشر القادمة وتتجدد تلقائيًا. يمكنك تفعيل أو إيقاف كل صلاة على حدة من زر الجرس في شاشة الصلاة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগামী ১২ দিনের নোটিফিকেশন আপনার ডিভাইসেই নির্ধারিত থাকে এবং নিজে থেকেই সামনে এগিয়ে যায়। নামাজ স্ক্রিনের ঘণ্টা বোতাম দিয়ে প্রতিটি নামাজ আলাদাভাবে চালু বা বন্ধ করতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are scheduled on your device for the next 12 days and roll forward automatically. Toggle individual prayers with the bell on the Prayer screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones se programan en tu dispositivo para los próximos 12 días y se renuevan automáticamente. Activa o desactiva cada oración con la campana de la pantalla Oración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌ها برای ۱۲ روز آینده روی دستگاه شما زمان‌بندی می‌شوند و خودبه‌خود به‌روز می‌مانند. هر نماز را جداگانه با زنگولهٔ صفحهٔ نماز روشن یا خاموش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont programmées sur votre appareil pour les 12 prochains jours et se renouvellent automatiquement. Activez ou désactivez chaque prière avec la cloche, sur l’écran Prière."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi dijadwalkan di perangkat Anda untuk 12 hari ke depan dan diperbarui otomatis. Aktifkan atau matikan tiap salat lewat ikon bel di layar Salat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dijadualkan pada peranti anda untuk 12 hari akan datang dan diperbaharui secara automatik. Hidupkan atau matikan setiap solat dengan ikon loceng pada skrin Solat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler cihazınızda önümüzdeki 12 gün için planlanır ve otomatik olarak yenilenir. Namaz ekranındaki zil simgesiyle her namazı ayrı ayrı açıp kapatabilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات آپ کے آلے پر اگلے ۱۲ دن کے لیے طے کی جاتی ہیں اور خودبخود آگے بڑھتی رہتی ہیں۔ ہر نماز الگ الگ نماز کی اسکرین پر گھنٹی کے ذریعے آن یا آف کریں۔"
          }
        }
      }
    },
