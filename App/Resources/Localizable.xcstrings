    "Free forever — fi sabilillah. No ads, no tracking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاني للأبد — في سبيل الله. بلا إعلانات، بلا تتبع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চিরকাল ফ্রি — ফি সাবিলিল্লাহ। কোনো বিজ্ঞাপন নেই, কোনো ট্র্যাকিং নেই।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis para siempre, fi sabilillah. Sin anuncios ni rastreo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همیشه رایگان — فی سبیل‌الله. بدون تبلیغ، بدون ردیابی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pour toujours — fi sabilillah. Sans publicité, sans suivi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis selamanya — fi sabilillah. Tanpa iklan, tanpa pelacakan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percuma selamanya — fi sabilillah. Tiada iklan, tiada penjejakan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonsuza dek ücretsiz — fî sebîlillâh. Reklam yok, takip yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمیشہ مفت — فی سبیل اللہ۔ نہ اشتہار، نہ ٹریکنگ۔"
          }
        }
      }
    },
