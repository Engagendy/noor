    },
    "Couldn't get your location. Try again, or pick a city manually.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحديد موقعك. أعد المحاولة، أو اختر مدينة يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লোকেশন পাওয়া গেল না। আবার চেষ্টা করুন, অথবা নিজে একটি শহর বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener tu ubicación. Inténtalo de nuevo o elige una ciudad manualmente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت شما به‌دست نیامد. دوباره تلاش کنید، یا شهری را دستی انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position introuvable. Réessayez, ou choisissez une ville manuellement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa mendapatkan lokasi Anda. Coba lagi, atau pilih kota secara manual."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi anda tidak dapat diperoleh. Cuba lagi, atau pilih bandar secara manual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuz alınamadı. Tekrar deneyin veya bir şehri elle seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مقام معلوم نہیں ہو سکا۔ دوبارہ کوشش کریں، یا خود کوئی شہر منتخب کریں۔"
          }
        }
