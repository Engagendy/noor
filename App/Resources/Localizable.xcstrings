          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik mana-mana bunyi untuk mendengarnya"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duymak için bir sese dokunun"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بھی آواز سننے کے لیے اسے ٹیپ کریں"
          }
        }
      }
    },
    "Tap the heart on any dhikr to keep it here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على القلب في أي ذكر ليظهر هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো জিকিরের হৃদয় চিহ্নে ট্যাপ করলে তা এখানে থাকবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el corazón de cualquier dhikr para guardarlo aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی قلبِ هر ذکر بزنید تا اینجا نگه داشته شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cœur d'un dhikr pour le garder ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ikon hati pada zikir mana pun untuk menyimpannya di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ikon hati pada mana-mana zikir untuk menyimpannya di sini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir zikri burada tutmak için üzerindeki kalbe dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی ذکر پر دل کے نشان کو دبائیں تاکہ وہ یہاں محفوظ رہے۔"
          }
        }
      }
    },
