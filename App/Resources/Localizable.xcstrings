    "That's not it — here's a new one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليست هذه الإجابة — إليك سؤالًا جديدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সঠিক উত্তর নয় — এই নিন নতুন একটি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's not it — here's a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es esa: aquí va otra pregunta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درست نبود — این هم یک سؤال تازه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas ça — voici une nouvelle question."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan itu — ini soal yang baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan itu jawapannya — ini soalan baharu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu değil — işte yeni bir soru."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ جواب درست نہیں — یہ لیجیے نیا سوال۔"
          }
        }
      }
    },
    "The mushaf text shown follows Hafs; the recitation follows Warsh.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص المعروض برواية حفص، والتلاوة برواية ورش عن نافع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখানো মুসহাফের টেক্সট হাফস অনুযায়ী; তিলাওয়াত ওয়ারশ অনুযায়ী।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mushaf text shown follows Hafs; the recitation follows Warsh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del mushaf sigue la riwaya de Hafs; la recitación sigue la de Warsh."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن مصحف به روایت حفص است و تلاوت به روایت ورش."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte du Mushaf affiché suit Hafs ; la récitation suit Warsh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks mushaf yang ditampilkan mengikuti riwayat Hafs; tilawahnya mengikuti riwayat Warsh."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks mushaf yang dipaparkan mengikut riwayat Hafs; bacaannya mengikut riwayat Warsh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterilen mushaf metni Hafs rivayetine, tilavet ise Verş rivayetine göredir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دکھایا گیا مصحف کا متن روایتِ حفص کے مطابق ہے؛ تلاوت روایتِ ورش کے مطابق ہے۔"
          }
        }
      }
    },
