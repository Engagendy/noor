    "Send the app to family and friends — a poster with the store links, ready for a status.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل التطبيق للأهل والأصدقاء: صورة فيها روابط المتجر، جاهزة للحالة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবার ও বন্ধুদের অ্যাপটি পাঠান — স্টোর লিংকসহ একটি পোস্টার, স্ট্যাটাসে দেওয়ার জন্য তৈরি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the app to family and friends — a poster with the store links, ready for a status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía la app a familiares y amigos: una imagen con los enlaces de las tiendas, lista para un estado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه را برای خانواده و دوستان بفرستید — پوستری با پیوندهای فروشگاه، آمادهٔ گذاشتن در استوری."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez l’app à vos proches — une affiche avec les liens des stores, prête pour un statut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim aplikasi ini ke keluarga dan teman — poster berisi tautan toko, siap dijadikan status."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar apl ini kepada keluarga dan rakan — poster dengan pautan gedung aplikasi, sedia untuk status."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı ailenize ve arkadaşlarınıza gönderin — mağaza bağlantılarını içeren, duruma hazır bir görsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ اہلِ خانہ اور دوستوں کو بھیجیں — اسٹور کے لنکس والا پوسٹر، اسٹیٹس کے لیے تیار۔"
          }
        }
      }
    },
