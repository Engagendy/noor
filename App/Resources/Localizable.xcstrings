    "It is kept on the device, so this surah opens offline next time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ في الجهاز، فتُفتح هذه السورة دون إنترنت في المرة القادمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ডিভাইসে রাখা হয়, তাই পরের বার এই সূরা অফলাইনেই খুলবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en el dispositivo, así esta sura se abrirá sin conexión la próxima vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی دستگاه نگه داشته می‌شود، پس دفعهٔ بعد این سوره آفلاین باز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle reste sur l’appareil : cette sourate s’ouvrira hors ligne la prochaine fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan di perangkat, sehingga surah ini terbuka offline lain kali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia disimpan pada peranti, jadi surah ini boleh dibuka luar talian pada kali seterusnya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazda saklanır, böylece bu sure bir dahaki sefere çevrimdışı açılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آلے پر محفوظ رہتی ہے، اس لیے اگلی بار یہ سورہ آف لائن کھل جائے گی۔"
          }
        }
      }
    },
