    "A beautiful adhan at every prayer. You can change or silence it anytime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أذان جميل عند كل صلاة. يمكنك تغيير الصوت أو إيقافه لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি নামাজে সুন্দর একটি আজান। যেকোনো সময় সেটি বদলাতে বা নীরব করতে পারবেন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hermoso adán en cada oración. Puedes cambiarlo o silenciarlo cuando quieras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اذانی دلنشین در وقت هر نماز. هر زمان بخواهید می‌توانید آن را عوض یا بی‌صدا کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bel adhan à chaque prière. Vous pouvez le changer ou le désactiver à tout moment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Azan yang merdu di setiap waktu salat. Anda bisa menggantinya atau membisukannya kapan saja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Azan yang merdu pada setiap waktu solat. Anda boleh menukar atau menyenyapkannya bila-bila masa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her namazda güzel bir ezan. İstediğiniz zaman değiştirebilir veya susturabilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر نماز پر خوبصورت اذان۔ جب چاہیں بدل یا خاموش کر سکتے ہیں۔"
          }
        }
      }
    },
    "A gentle reminder before each adhan — time for wudu and the walk to the masjid.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير لطيف قبل كل أذان — وقت للوضوء والمشي إلى المسجد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি আজানের আগে একটি মৃদু স্মরণ — অজু করে মসজিদে যাওয়ার সময়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle reminder before each adhan — time for wudu and the walk to the masjid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio suave antes de cada adán: tiempo para el wudú y para ir a la mezquita."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادآوری ملایم پیش از هر اذان — وقت وضو و رفتن به مسجد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel discret avant chaque adhan — le temps du wudu et du trajet vers la mosquée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat lembut sebelum setiap azan — waktunya berwudu dan berjalan ke masjid."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan lembut sebelum setiap azan — masa untuk berwuduk dan berjalan ke masjid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ezandan önce nazik bir hatırlatma — abdest ve camiye yürüyüş vakti."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر اذان سے پہلے ایک نرم یاد دہانی — وضو کرنے اور مسجد تک جانے کا وقت۔"
          }
        }
      }
    },
    "A simpler Quran for children, with a grown-up lock.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرآن أبسط للأطفال، مع قفل لولي الأمر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিশুদের জন্য সহজ কুরআন, সঙ্গে অভিভাবকের লক।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A simpler Quran for children, with a grown-up lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Corán más sencillo para niños, con bloqueo para adultos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قرآنی ساده‌تر برای کودکان، با قفلی برای بزرگ‌ترها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Coran plus simple pour les enfants, avec un verrou parental."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Al-Qur'an yang lebih sederhana untuk anak, dengan kunci untuk orang dewasa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Al-Quran yang lebih mudah untuk kanak-kanak, dengan kunci untuk orang dewasa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuklar için daha sade bir Kur'an; büyüklere özel kilidiyle."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بچوں کے لیے سادہ قرآن، ساتھ میں بڑوں کا تالا۔"
          }
        }
      }
    },
