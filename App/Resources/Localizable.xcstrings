    "Reads each ayah in the chosen language right after the Arabic.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ كل آية باللغة المختارة بعد التلاوة العربية مباشرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরবি তিলাওয়াতের পরপরই প্রতিটি আয়াত নির্বাচিত ভাষায় পড়ে শোনায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads each ayah in the chosen language right after the Arabic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee cada aleya en el idioma elegido justo después del árabe."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر آیه بلافاصله پس از عربی به زبان انتخابی خوانده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque verset est lu dans la langue choisie juste après l’arabe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membacakan tiap ayat dalam bahasa pilihan tepat setelah bacaan Arabnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca setiap ayat dalam bahasa pilihan sebaik sahaja selepas bacaan Arab."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ayeti Arapçasının hemen ardından seçtiğiniz dilde okur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر آیت عربی کے فوراً بعد منتخب زبان میں پڑھی جاتی ہے۔"
          }
        }
      }
    },
