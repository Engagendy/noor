<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tahajjud launch window (bgPrimary dark) so system-dark users
         don't see a paper flash before Compose takes over. -->
    <!-- Must stay an AppCompat descendant (AppCompatActivity requirement);
         a Material parent here crashed every system-dark device at launch. -->
    <style name="Theme.Noor" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0F1512</item>
        <item name="android:statusBarColor">#0F1512</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
