<?xml version="1.0" encoding="utf-8"?>
<!-- Required from Android 13: AppCompatDelegate.setApplicationLocales
     forwards to the system LocaleManager there, and the system ignores a
     per-app locale unless the app declares which locales it supports.
     Without this the language picker in onboarding and in Settings does
     nothing on API 33+, and the app is missing from
     Settings > System > Languages > App languages.

     EVERY language the app ships MUST be listed here. Adding a values-<code>/
     bucket without adding the code here is silent: the strings exist, the
     picker offers the language, and nothing changes on screen.

     Arabic first: it is the default (unqualified values/). The other nine
     have values-<code>/ buckets. Same list, same order, as the iOS
     `NoorLanguage` enum. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ar" />
    <locale android:name="en" />
    <locale android:name="id" />
    <locale android:name="ur" />
    <locale android:name="fa" />
    <locale android:name="tr" />
    <locale android:name="ms" />
    <locale android:name="bn" />
    <locale android:name="fr" />
    <locale android:name="es" />
</locale-config>
